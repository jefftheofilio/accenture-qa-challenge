{
  "name": "accenture-qa-challenge",
  "version": "1.0.0",
  "description": "Desafio de QA Automation - Accenture | API + Web",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.feature'",
    "test:web": "cypress run --spec 'cypress/e2e/web/**/*.feature'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jefftheofilio/accenture-qa-challenge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jefftheofilio/accenture-qa-challenge/issues"
  },
  "homepage": "https://github.com/jefftheofilio/accenture-qa-challenge#readme",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.0.0",
    "esbuild": "^0.28.2"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/**/*.steps.js"
    ],
    "messages": {
      "enabled": true,
      "output": "reports/messages.ndjson"
    },
    "json": {
      "enabled": true,
      "output": "reports/cucumber-report.json"
    },
    "html": {
      "enabled": true,
      "output": "reports/cucumber-report.html"
    }
  }
}
